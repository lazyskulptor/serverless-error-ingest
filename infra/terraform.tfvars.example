# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored — never commit real secrets.

region           = "ap-northeast-2"
name_prefix      = "sentry-ingest"
environment      = "dev"
stage            = "v1"

# Optional custom API hostname. Leave empty to use the API Gateway URL.
domain_name = ""
dns_provider = "aws" # aws or cloudflare

# Set only the zone ID selected by dns_provider.
route53_zone_id   = ""
cloudflare_zone_id = ""
cloudflare_proxied = false

# MUST be globally unique across all AWS accounts.
raw_bucket_name  = "sentry-ingest-raw-dev"

# Optional existing SNS topic for CloudWatch alarm/OK notifications.
alarm_sns_topic_arn = ""
s3_object_count_alarm_threshold = 100000
s3_bucket_size_alarm_bytes = 5368709120 # 5 GiB
api_hourly_request_alarm_threshold = 10000
